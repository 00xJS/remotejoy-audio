+/*------------------------------------------------------------------------------*/
+/* Shutdown																		*/
+/*																				*/
+/* Exiting a game to the XMB does NOT call module_stop - the firmware reboots	*/
+/* the kernel instead (loadexec runReboot). Without the reboot notifications		*/
+/* below, this plugin keeps a VBlank sub-interrupt handler, patched syscall		*/
+/* slots and two kernel threads live while sceAudio/sceDisplay/USB tear			*/
+/* themselves down underneath it - which is what froze the PSP.					*/
+/*------------------------------------------------------------------------------*/
+static void RjlQuiesce( void )
+{
+	Quitting    = 1;
+	ScreenReady = 0;
+	AudioSetActive( 0 );		/* audio wrappers stop capturing				*/
+	TranceAsyncOff();			/* release the VBlank sub-interrupt vector		*/
+}
+
+static void RjlTeardown( void )
+{
+	static int done = 0;
+	if ( done ){ return; }
+	done = 1;
+
+	RjlQuiesce();
+	unhookAudio();				/* put the sceAudio syscall slots back			*/
+}
+
+/*------------------------------------------------------------------------------*/
+/* module_reboot_phase : runs before user threads are suspended					*/
+/*------------------------------------------------------------------------------*/
+int module_reboot_phase( int arg1, void *arg2, int arg3, int arg4 )
+{
+	(void)arg1; (void)arg2; (void)arg3; (void)arg4;
+	RjlQuiesce();
+	return( 0 );
+}
+
+/*------------------------------------------------------------------------------*/
+/* module_reboot_before : runs after user threads are suspended, before			*/
+/* reboot.bin is loaded - the correct place to restore what we patched.			*/
+/*------------------------------------------------------------------------------*/
+int module_reboot_before( void *argp, int arg1, int arg2, int arg3 )
+{
+	(void)argp; (void)arg1; (void)arg2; (void)arg3;
+	RjlTeardown();
+	return( 0 );
+}
+
 /*------------------------------------------------------------------------------*/
 /* module_start																	*/
 /*------------------------------------------------------------------------------*/
@@ -364,6 +423,8 @@ int module_start( SceSize args, void *argp )
 /*------------------------------------------------------------------------------*/
 int module_stop( SceSize args, void *argp )
 {
+	RjlTeardown();
+
 	if ( ScreenThreadID  >= 0 ){ sceKernelDeleteThread( ScreenThreadID ); }
 	if ( ScreenEventFlag >= 0 ){ sceKernelDeleteEventFlag( ScreenEventFlag ); }
 	if ( ScreenSemaphore >= 0 ){ sceKernelDeleteSema( ScreenSemaphore ); }
