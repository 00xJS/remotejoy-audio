+/*------------------------------------------------------------------------------*/
+/* SyscallPtrOk : only ever dereference something that looks like RAM			*/
+/*------------------------------------------------------------------------------*/
+int SyscallPtrOk( const void *p )
+{
+	u32 a = (u32)p;
+	if ( a == 0 ){ return( 0 ); }
+	if ( a & 3 ){ return( 0 ); }
+	a &= 0x1FFFFFFF;
+	if ( (a >= 0x08000000) && (a < 0x0C000000) ){ return( 1 ); }	/* kernel+user RAM	*/
+	if ( (a >= 0x04000000) && (a < 0x04200000) ){ return( 1 ); }	/* VRAM				*/
+	return( 0 );
+}
+
+/*------------------------------------------------------------------------------*/
+/* SyscallCountMatches : READ-ONLY. Counts slots holding `addr` (top bit		*/
+/* ignored) in the table at `base`, and reports the table's declared size.		*/
+/* Writes nothing - v7 wrote to every match and crashed the PSP, so we measure	*/
+/* the real layout before touching it again.									*/
+/*------------------------------------------------------------------------------*/
+int SyscallCountMatches( void *base, void *addr, int *out_size )
+{
+	u32 *tbl = (u32 *)base;
+	int i, size, hits = 0;
+
+	if ( out_size != NULL ){ *out_size = -1; }
+	if ( !SyscallPtrOk( tbl ) ){ return( -1 ); }
+
+	size = (int)((tbl[3] - 0x10) / sizeof(u32));
+	if ( out_size != NULL ){ *out_size = size; }
+	if ( (size <= 0) || (size > 0x8000) ){ return( -2 ); }
+	if ( !SyscallPtrOk( &tbl[4+size-1] ) ){ return( -3 ); }
+
+	u32 want = (u32)addr & 0x7FFFFFFF;
+	for ( i=0; i<size; i++ ){
+		if ( (tbl[4+i] & 0x7FFFFFFF) == want ){ hits++; }
+	}
+	return( hits );
+}
+
