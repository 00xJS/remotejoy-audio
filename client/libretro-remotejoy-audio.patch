+
+size_t remotejoy_audio_level(void)
+{
+   size_t n;
+   if (!g_alock) return 0;
+   slock_lock(g_alock);
+   n = g_aring_used;
+   slock_unlock(g_alock);
+   return n;
+}
+
+size_t remotejoy_audio_pop(int16_t *out, size_t frames)
+{
+   size_t got = 0;
+
+   if (!g_alock)
+      return 0;
+
+   slock_lock(g_alock);
+   while (got < frames && g_aring_used)
+   {
+      out[got * 2 + 0] = g_audio_ring[g_aring_r * 2 + 0];
+      out[got * 2 + 1] = g_audio_ring[g_aring_r * 2 + 1];
+      g_aring_r = (g_aring_r + 1) % AUDIO_RING_FRAMES;
+      g_aring_used--;
+      got++;
+   }
+   slock_unlock(g_alock);
+   return got;
+}
