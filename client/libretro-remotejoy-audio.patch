+                  "Read the counters in the [audio] stats line above: hooks=0 means the hooks did not "
+                  "install; out/panned/src all 0 means this game's audio never reaches the hooked calls.\n");
+         else
+            log_cb(RETRO_LOG_WARN, "[audio] No audio packets AND no stats from the PSP after ~5s. "
+                  "The PSP is almost certainly running a NON-audio RemoteJoyLite build. "
+                  "Run './swap-plugin.sh audio' (then reboot the PSP) and check './swap-plugin.sh status'.\n");
+      }
+   }
+
    // TODO: Employ a more "sane" scheme using conditional variables, etc.
    slock_lock(g_lock);
    memcpy(g_frame_buffer, g_frame, sizeof(g_frame));
