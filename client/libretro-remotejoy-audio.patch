+/* Dynamic rate control: the PSP produces 44100 frames/sec on its own clock,
+ * but RetroArch calls retro_run at the actual (often <60fps) video rate. A
+ * fixed 735-frame output drifts and the PSP-side buffer overflows -> chop.
+ * Instead, keep the client buffer near AUD_TARGET and let the batch size float,
+ * so average consumption equals production whatever the video rate is. */
+#define AUD_NOMINAL  735    /* 44100/60 */
+#define AUD_TARGET   2646   /* ~60ms cushion, absorbs frame-rate wobble */
+#define AUD_MAXBATCH 4096   /* cap */
+
 void retro_run(void)
 {
    run_program();
+
+   static int primed = 0;
+   static int16_t abuf[AUD_MAXBATCH * 2];
+   size_t level = remotejoy_audio_level();
+
+   /* fill the cushion before playing, so we don't start by underrunning */
+   if (!primed)
+   {
+      if (level < AUD_TARGET)
+      {
+         memset(abuf, 0, AUD_NOMINAL * 2 * sizeof(int16_t));
+         if (audio_batch_cb)
+            audio_batch_cb(abuf, AUD_NOMINAL);
+         return;
+      }
+      primed = 1;
+   }
+
+   /* Smooth the level first: audio arrives in ~1024-frame bursts, so the raw
+    * level sawtooths and a per-frame reaction makes the batch size jitter ->
+    * audible warble. A slow EMA tracks the true backlog; the batch size then
+    * changes gradually, holding a steady pitch. */
+   static double lvl_avg = -1.0;
+   if (lvl_avg < 0.0) lvl_avg = (double)level;
+   lvl_avg += ((double)level - lvl_avg) * 0.02;   /* ~0.8s time constant */
+
+   /* Divisor 8 (not 32) so the batch can reach ~2x nominal: at a dropped video
+    * rate (say 30fps) the client MUST consume ~1470 frames/call to keep up with
+    * the PSP's steady 44100/s, or its buffer overflows and drops -> chop. The
+    * EMA above keeps the change gradual, so a wide range does not warble. */
+   long want = AUD_NOMINAL + (long)((lvl_avg - AUD_TARGET) / 8.0);
+   if (want < 256)  want = 256;                 /* floor */
+   if (want > 2000) want = 2000;                /* ceiling: handles ~22fps */
+   if ((size_t)want > level) want = level;      /* never claim more than we have */
+   if (want > AUD_MAXBATCH) want = AUD_MAXBATCH;
+
+   size_t got = remotejoy_audio_pop(abuf, (size_t)want);
+   if ((size_t)want > got)
+      memset(abuf + got * 2, 0, ((size_t)want - got) * 2 * sizeof(int16_t));
+   if (audio_batch_cb && want > 0)
+      audio_batch_cb(abuf, (size_t)want);
+
+   if (level == 0)
+   {
+      primed  = 0;      /* ran dry: re-prime the cushion */
+      lvl_avg = -1.0;   /* and reset the smoother */
+   }
 }
 
 bool retro_load_game(const struct retro_game_info *info)
