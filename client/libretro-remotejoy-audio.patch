+      if (log_cb)
+         log_cb(RETRO_LOG_WARN, "[audio] stream rate %u != 44100, pitch will be off (resampling is a TODO).\n", rate);
+   }
+
+   slock_lock(g_alock);
+   for (size_t i = 0; i < frames; i++)
+   {
+      if (g_aring_used == AUDIO_RING_FRAMES)
+      {
+         g_aring_r = (g_aring_r + 1) % AUDIO_RING_FRAMES;
+         g_aring_used--;
+      }
+      g_audio_ring[g_aring_w * 2 + 0] = in[i * 2 + 0];
+      g_audio_ring[g_aring_w * 2 + 1] = in[i * 2 + 1];
+      g_aring_w = (g_aring_w + 1) % AUDIO_RING_FRAMES;
+      g_aring_used++;
+   }
+   slock_unlock(g_alock);
