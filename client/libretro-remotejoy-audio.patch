+   if (!g_alock)
+      return;
+
+   if (g_audio_packets++ == 0 && log_cb)
+      log_cb(RETRO_LOG_INFO, "[audio] FIRST PCM packet received: %zu bytes (%zu frames) at %u Hz\n",
+            bytes, frames, rate);
+
+   if (rate && rate != 44100 && !g_audio_rate_warned)
+   {
